{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tob check)",
      "Bash(tob check *)",
      "Bash(tob doctor)",
      "Bash(tob lint *)",
      "Bash(tob pack *)",
      "Bash(tob schemas *)",
      "Bash(tob sim *)",
      "Bash(tob verify *)",
      "Bash(tob fork *)",
      "Bash(tob db *)",
      "Bash(tob soak *)",
      "Bash(tob --version)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(tob deploy *)",
      "Bash(tob rollback *)",
      "Bash(tob host *)",
      "Bash(tob remote *)",
      "Bash(tob backup *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(pip install *)",
      "Bash(TOB_LIVE=1 *)",
      "Edit(./docs/ARCHITECTURE.md)",
      "Edit(./docs/BUILD_PLAN.md)",
      "Edit(./tools/kernel_nouns.txt)",
      "Edit(./src/basilisk/ops/nounlint.py)",
      "Edit(./tools/githooks/**)",
      "Edit(./deploy/**)",
      "Edit(./pyproject.toml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/etc/basilisk/**)",
      "Bash(cat .env*)",
      "Bash(cat /etc/basilisk/*)"
    ]
  }
}
